# Run output (sessions, artifacts, logs) — never tracked, except curated
# cross-machine baseline snapshots under results/baselines/ (see
# results/baselines/README.md and docs/DESIGN.md D24).
results/*
!results/baselines/

# Per-machine site config (paths); commit site.example.yaml instead
configs/site.local.yaml

# Built compressor artifacts inside submodules
external/**/build/
external/**/install/

# compressors/ is the portable recipe (manifest + patches + build scripts + vendored
# fork source). Actual checkouts land in $COMPRESSORS_ROOT (~/compressors), never here.
# Guard against a stray in-tree build or checkout.
compressors/vendor/**/build/
compressors/vendor/**/build-*/
compressors/vendor/**/build_*/
compressors/checkouts/

# nvcomp_cli is source in this repo, but its build tree is not
tools/**/build/
# Machine-specific helper outputs; sources and reproducible build scripts are tracked.
tools/fsz_hosttime/fsz_hosttime
tools/lscomp_decode/lscomp_decode

# Downloaded datasets
data/
datasets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.DS_Store

# SLURM job output landing in the repo root (submit scripts run from $SLURM_SUBMIT_DIR)
slurm-*.out
shard-*.log
